# ── Base de données ──────────────────────────────────────────────
# lakebase : Postgres Lakebase dans Databricks (cible)
# postgres : Postgres local (dev, avec `docker compose --profile local-db up`)
DB_MODE=lakebase
DB_SCHEMA=cellmed
SEED_ON_STARTUP=true

# ── Lakebase ─────────────────────────────────────────────────────
# Projet Lakebase (autoscaling) : la branche par défaut et son endpoint
# lecture/écriture sont trouvés automatiquement, ainsi que l'hôte Postgres.
LAKEBASE_PROJECT=e2097706-66d8-4048-aa68-c14a96999bbf
LAKEBASE_DATABASE=databricks_postgres
# Hôte Postgres de l'endpoint (optionnel, sinon trouvé automatiquement)
# LAKEBASE_ENDPOINT=projects/<projet>/branches/<branche>/endpoints/<endpoint>
LAKEBASE_HOST=ep-nameless-bird-d8bppdjf.database.us-east-2.cloud.databricks.com
# Rôle Postgres (laisser vide = identité Databricks ci-dessous)
LAKEBASE_USER=

# ── Authentification Databricks (lue par le SDK) ─────────────────
DATABRICKS_HOST=https://dbc-db45eff8-0dff.cloud.databricks.com
# Lakebase exige OAuth (les tokens personnels PAT sont refusés).
# Docker : service principal OAuth (M2M), voir README
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Sans Docker : profil Databricks CLI à la place des deux lignes ci-dessus
# DATABRICKS_CONFIG_PROFILE=

# ── Stockage des documents déposés ───────────────────────────────
# db     : contenu stocké dans Lakebase (table cellmed.fichier) — par défaut
# volume : contenu stocké dans un Volume Unity Catalog (le service principal
#          doit avoir READ VOLUME / WRITE VOLUME dessus)
STORAGE_MODE=db
# UC_VOLUME_PATH=/Volumes/<catalogue>/<schema>/<volume>
MAX_UPLOAD_MO=10

# ── Portail assuré « Certificat médical » ────────────────────────
# Base des liens d'invitation envoyés aux assurés
PORTAIL_URL=http://localhost:8081
OTP_DUREE_MIN=10
SESSION_DUREE_MIN=120
# En mode dev, le code à 6 chiffres est aussi affiché à l'écran (jamais en mode aws)
PORTAIL_AFFICHER_CODE_DEV=true

# ── Soumission du certificat ──────────────────────────────────────
# direct         : le backend crée le dossier CellMed immédiatement (développement sans AWS)
# step_functions : le backend lance la machine à états ecmd-soumission-certificat, dont la Lambda
#                  ecmd-creer-dossier crée le dossier dans Lakebase puis envoie l'accusé de réception
SOUMISSION_MODE=direct
# SOUMISSION_STATE_MACHINE_ARN=arn:aws:states:eu-west-3:000000000000:stateMachine:ecmd-soumission-certificat

# ── Données Open (gold Databricks synchronisé dans Lakebase) ─────
# Lue quand l'assuré ouvre son lien (création de l'invitation, préremplissage du certificat).
# Table synchronisée depuis <catalog>.gold.sinistre_prerempli (schéma.table Postgres)
OPEN_TABLE=ecmd_gold.sinistre_prerempli
# Table de démonstration créée au démarrage (par défaut : seulement si DB_MODE=postgres)
# OPEN_DEMO=false

# ── Liens d'invitation signés (AWS Lambda « generer_lien ») ─────────
# Secret partagé entre la Lambda et le backend pour vérifier les liens envoyés aux assurés.
# 64 caractères hexadécimaux : openssl rand -hex 32   (en production : AWS Secrets Manager)
PORTAIL_SECRET_LIENS=

# ── Envoi des emails et SMS ──────────────────────────────────────
# dev : rien n'est envoyé, les messages sont écrits dans les logs du backend
# aws : emails via Amazon SES, SMS via Amazon SNS
NOTIF_MODE=dev
AWS_REGION=eu-west-3
# LocalStack (docker compose --profile aws) ; vide = AWS réel
# Jeton du compte LocalStack, exigé par les images récentes (https://app.localstack.cloud → Auth Token)
# LOCALSTACK_AUTH_TOKEN=
# Active le profil « aws » sans avoir à écrire --profile aws
# COMPOSE_PROFILES=aws
# AWS_ENDPOINT_URL=http://localstack:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
SES_EXPEDITEUR=no-reply@cellmed.fr
SMS_EXPEDITEUR=CellMed

# ── Utilisateur courant (en attendant le SSO) ────────────────────
# Compte cherché par email dans la table utilisateur (créé s'il n'existe pas)
DEFAULT_USER_EMAIL=dr.martin@cellmed.fr
DEFAULT_USER_NAME=Dr. Martin
DEFAULT_USER_ROLE=Gestionnaire Junior

# Ports locaux
CELLMED_PORT=8080
CERTIFICAT_PORT=8081
